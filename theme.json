		"layout": {
			"contentSize": "736px",
			"wideSize": "1152px"
		},
		"spacing": {
			"units": [
				"px",
				"em",
				"rem",
				"%",
				"vw"
			]
		},
		"typography": {
			"dropCap": false,
			"fluid": false,
			"fontFamilies": [
				{
					"slug": "antonio",
					"name": "Antonio (LCARS)",
					"fontFamily": "Antonio, \"Arial Narrow\", \"Avenir Next Condensed\", sans-serif"
				},
				{
					"slug": "system-sans",
					"name": "System sans-serif",
					"fontFamily": "system-ui, -apple-system, \"Segoe UI\", Roboto, \"Helvetica Neue\", Arial, sans-serif"
				},
				{
					"slug": "monospace",
					"name": "Monospace",
					"fontFamily": "ui-monospace, SFMono-Regular, Menlo, Consolas, \"Liberation Mono\", monospace"
				}
			],
			"fontSizes": [
				{
					"slug": "small",
					"name": "Small",
					"size": "1rem"
				},
				{
					"slug": "medium",
					"name": "Medium",
					"size": "1.25rem"
				},
				{
					"slug": "large",
					"name": "Large",
					"size": "1.75rem"
				},
				{
					"slug": "x-large",
					"name": "Extra large",
					"size": "2.5rem"
				},
				{
					"slug": "xx-large",
					"name": "Huge",
					"size": "3.5rem"
				}
			]
		}
	},
	"styles": {
		"color": {
			"background": "#000000",
			"text": "#f5f6fa"
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--antonio)"
		},
		"elements": {
			"button": {
				"border": {
					"radius": "999px",
					"width": "0"
				},
				"color": {
					"background": "var(--lcars-accent-1, #ff9900)",
					"text": "#000000"
				},
				"typography": {
					"fontFamily": "inherit",
					"fontSize": "1.1rem",
					"letterSpacing": "0.06em",
					"lineHeight": "1.2",
					"textTransform": "uppercase"
				},
				"spacing": {
					"padding": {
						"top": "0.35rem",
						"right": "1.4rem",
						"bottom": "0.35rem",
						"left": "1.4rem"
					}
				}
			},
			"link": {
				"color": {
					"text": "var(--lcars-link, #99ccff)"
				}
			}
		}
	}
}
